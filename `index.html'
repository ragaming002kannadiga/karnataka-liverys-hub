        .card img { width: 100%; height: 180px; object-fit: cover; }
        .card-content { padding: 15px; }
        .card-content h3 { font-size: 18px; margin-bottom: 8px; color: #222; }
        .card-content p { font-size: 14px; color: #666; margin-bottom: 15px; }
        
