            padding: 10px; 
            text-decoration: none; 
            border-radius: 5px; 
            font-weight: bold;
            transition: background 0.2s;
        }
        .btn:hover { background: #218838; }

        /* Footer */
        footer { background: #111; color: white; text-align: center; padding: 20px; margin-top: 40px; border-top: 4px solid #ffcc00; font-size: 14px; }
